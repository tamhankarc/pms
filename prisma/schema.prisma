  market       CopyDeckMarket? @relation(fields: [marketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User        @relation("CopyDeckCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
