generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  MANAGER
  TEAM_LEAD
  EMPLOYEE
  REPORT_VIEWER
  ACCOUNTS
  HR
  OPERATIONS
}

enum FunctionalRoleCode {
  DEVELOPER
  QA
  DESIGNER
  LOCALIZATION
  DEVOPS
  PROJECT_MANAGER
  DIRECTOR
  GENERAL_MANAGER
  OTHER
  BILLING
}

enum BillingModel {
  HOURLY
  FIXED_FULL
  FIXED_MONTHLY
  FIXED_PER_COUNTRY
  FIXED_COST
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
}

enum WarnerProjectType {
  OTHER
  PORTAL
  DVD
  TICKETING
  SOCIAL
}

enum SonyProjectType {
  OTHER
  NEWSLETTERS
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  COMPLETED_BILLED
  ARCHIVED
}

enum EstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISED
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISED
}

enum NewsletterType {
  ISG
  AFFIRM
  HOME
}

enum MovieBillingHeadCompulsion {
  FIXED_COMPULSORY
  FIXED_OPTIONAL
}

enum MovieBillingHeadCostType {
  WHOLE_COST
  PER_UNIT_COST
}

enum MovieBillingRegion {
  DOMESTIC
  INTL
  OTHER
  SOCIAL
  PORTAL
}

enum MovieStatus {
  WORKING
  COMPLETED
  COMPLETED_BILLED
}

enum AttendanceActionType {
  MARK_IN
  MARK_OUT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  RECONSIDER
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  OTHER
}

enum LeaveDayDuration {
  FULL_DAY
  HALF_DAY
}

enum LeaveDaySelectionMode {
  FULL_DAYS
  HALF_DAYS
  CUSTOM
}

enum ShiftType {
  DAY
  NIGHT
}

enum HolidayShift {
  DAY
  NIGHT
  BOTH
}

enum EmploymentStatus {
  PROBATION
  PERMANENT
  CONSULTANT
}

enum PurchaseOrderAssignmentMode {
  NOT_REQUIRED
  TITLE
  TITLE_COUNTRY
  TITLE_BILLING_REPORT
  TITLE_PROJECT
  PROJECT
  BILLING_REPORT
}

enum BillingContactAssignmentLevel {
  CLIENT
  CLIENT_PROJECT
  CLIENT_BILLING_REPORT
}

enum PurchaseOrderStatus {
  ACTIVE
  PROCESSED
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum CopyDeckTranslationSource {
  PROVIDER
  AUTO_TRANSLATED
  ENGLISH_FALLBACK
  MASTER
  MASTER_UPLOAD
  CLIENT_CORRECTED
}

model User {
  id                     String              @id @default(cuid())
  fullName               String
  username               String              @unique
  email                  String              @unique
  passwordHash           String
  userType               UserType
  functionalRole         FunctionalRoleCode?
  employeeCode           String?             @unique
  designation            String?
  joiningDate            DateTime?
  phoneNumber            String?
  secondaryPhoneNumber   String?
  isActive               Boolean             @default(true)
  currentAddress         String?             @db.Text
  currentAddressLine     String?             @db.Text
  currentCity            String?
  currentState           String?
  currentCountry         String?
  currentPostalCode      String?
  permanentAddress       String?             @db.Text
  permanentAddressLine   String?             @db.Text
  permanentCity          String?
  permanentState         String?
  permanentCountry       String?
  permanentPostalCode    String?
  permanentSameAsCurrent Boolean             @default(false)
  extraMenuItemsJson     String?             @db.Text
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  createdProjects Project[] @relation("ProjectCreatedBy")
  updatedProjects Project[] @relation("ProjectUpdatedBy")

  projectAssignments    ProjectUserAssignment[]
  subProjectAssignments SubProjectAssignment[]

  managedEmployees           EmployeeTeamLead[] @relation("TeamLeadAssignments")
  employeeSupervisors        EmployeeTeamLead[] @relation("EmployeeAssignments")
  teamLeadAssignmentsCreated EmployeeTeamLead[] @relation("EmployeeTeamLeadAssignedBy")

  estimates       Estimate[]
  estimateReviews EstimateReview[] @relation("EstimateReviewer")

  timeEntries      TimeEntry[]
  timeEntryReviews TimeEntryReview[] @relation("TimeEntryReviewer")

  attendanceLogs           AttendanceLog[]
  leaveRequests            LeaveRequest[]                   @relation("LeaveRequestEmployee")
  leaveRequestsToApprove   LeaveRequest[]                   @relation("LeaveRequestApprover")
  selectedLeaveApprovals   LeaveRequestSelectedApprover[]   @relation("LeaveRequestSelectedApproverUser")
  leaveApproverAssignments LeaveApproverAssignment[]        @relation("LeaveApproverEmployee")
  approverForEmployees     LeaveApproverAssignment[]        @relation("LeaveApproverUser")
  leaveApprovalsAssignedBy LeaveApproverAssignment[]        @relation("LeaveApproverAssignedBy")
  leaveYearProfiles        LeaveYearProfile[]
  announcementRecipients   DashboardAnnouncementRecipient[]
  sweepInTriggersCreated SweepInTrigger[]     @relation("SweepInTriggerCreatedBy")
  sweepInTriggerSelections SweepInTriggerUser[] @relation("SweepInTriggerUser")
  copyDecksCreated         CopyDeck[]            @relation("CopyDeckCreatedBy")

  @@index([userType, isActive])
  @@index([functionalRole, isActive])
}

model Client {
  id                         String   @id @default(cuid())
  name                       String
  code                       String?  @unique
  isActive                   Boolean  @default(true)
  showCountriesInTimeEntries Boolean  @default(false)
  showMoviesInEntries        Boolean  @default(false)
  showAssetTypesInEntries    Boolean  @default(false)
  showLensTypesInEntries     Boolean  @default(false)
  lensFirstPlatformCost      Decimal  @default(0) @db.Decimal(12, 2)
  lensSubsequentPlatformCost Decimal  @default(0) @db.Decimal(12, 2)
  showAssetNamesInEntries    Boolean  @default(false)
  showLanguagesInEntries     Boolean  @default(false)
  showNewslettersInEntries   Boolean  @default(false)
  enableProjectTypes         Boolean  @default(false)
  hourlyCost                 Decimal  @default(0) @db.Decimal(12, 2)
  sonyCoppaSiteCost          Decimal  @default(0) @db.Decimal(12, 2)
  sonyUsEpkSiteCost          Decimal  @default(0) @db.Decimal(12, 2)
  sonyGlobalEpkSiteCost      Decimal  @default(0) @db.Decimal(12, 2)
  poAssignmentMode            PurchaseOrderAssignmentMode @default(NOT_REQUIRED)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  movies                      Movie[]
  newsletters                 Newsletter[]
  assetNames                  AssetName[]
  assetTypes                  AssetType[]
  projects                    Project[]
  projectTypes                ProjectType[]
  contactPersons              ContactPerson[]
  filmikResourceTypes          FilmikResourceType[]
  movieBillingHeads           MovieBillingHead[]
  movieBillingHeadAssignments MovieBillingHeadAssignment[]
  monthlyBillings             ClientMonthlyBilling[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderAssignments    PurchaseOrderAssignment[]
  billingContactAssignments   BillingContactAssignment[]
  billingRecords              BillingRecord[]
  copyDecks                   CopyDeck[]

  @@index([isActive])
}

model ContactPerson {
  id            String   @id @default(cuid())
  clientId      String
  projectId     String?
  movieId       String?
  purchaseOrderId String?
  name          String
  email         String
  contactNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  country   Country? @relation(fields: [countryId], references: [id])
  primaryForMovies Movie[] @relation("MoviePrimaryContactPerson")
  primaryForProjects Project[] @relation("ProjectPrimaryContactPerson")
  billingContactAssignments BillingContactAssignment[]
  countryId String?

  @@index([clientId])
  @@index([projectId])
  @@index([movieId])
  @@index([purchaseOrderId])
  @@index([email])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  clientId    String
  poNumber    String
  amount      Decimal?            @db.Decimal(12, 2)
  currency    String              @default("USD")
  poDate      DateTime?
  validFrom   DateTime?
  validTo     DateTime?
  status      PurchaseOrderStatus @default(ACTIVE)
  documentUrl String?             @db.Text
  notes       String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  client        Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignments   PurchaseOrderAssignment[]
  contactPersons ContactPerson[]
  billingRecords BillingRecord[]

  @@unique([clientId, poNumber])
  @@index([clientId, status])
  @@index([poNumber])
}

model PurchaseOrderAssignment {
  id                String                      @id @default(cuid())
  clientId          String
  purchaseOrderId   String
  assignmentMode    PurchaseOrderAssignmentMode
  movieId           String?
  projectId         String?
  billingReportType String?
  billingMonth      Int?
  billingYear       Int?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movie         Movie?        @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  countries     PurchaseOrderAssignmentCountry[] @relation("PurchaseOrderAssignmentCountries")

  @@index([clientId, assignmentMode])
  @@index([purchaseOrderId])
  @@index([movieId])
  @@index([projectId])
  @@index([billingReportType])
}

model PurchaseOrderAssignmentCountry {
  id           String   @id @default(cuid())
  assignmentId String
  countryId    String
  createdAt    DateTime @default(now())

  assignment PurchaseOrderAssignment @relation("PurchaseOrderAssignmentCountries", fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "poa_country_assignmentId_fkey")
  country    Country                 @relation("CountryPurchaseOrderAssignmentCountries", fields: [countryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "poa_country_countryId_fkey")

  @@unique([assignmentId, countryId])
  @@index([assignmentId])
  @@index([countryId])
}

model ProjectType {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projects Project[]

  @@unique([clientId, name])
  @@index([clientId, isActive])
}

model Movie {
  id                           String             @id @default(cuid())
  clientId                     String
  contactPersonId              String?
  title                        String
  code                         String?            @unique
  description                  String?            @db.Text
  billingRegion                MovieBillingRegion @default(DOMESTIC)
  billingDomestic              Boolean            @default(true)
  billingIntl                  Boolean            @default(false)
  billingOther                 Boolean            @default(false)
  billingSocial                Boolean            @default(false)
  billingPortal                Boolean            @default(false)
  billingInvoiceNumber         String?
  otherCountryIds              String?            @db.Text
  billingUnitsJson             String?            @db.Text
  sonyTicketingBannerCost      Decimal            @default(0) @db.Decimal(12, 2)
  sonyEmailTicketingBannerCost Decimal            @default(0) @db.Decimal(12, 2)
  sonyCoppaSite                Boolean            @default(false)
  sonyGlobalEpkSite            Boolean            @default(false)
  status                       MovieStatus        @default(WORKING)
  billingDate                  DateTime?
  isActive                     Boolean            @default(true)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  client                      Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  primaryContactPerson        ContactPerson?                @relation("MoviePrimaryContactPerson", fields: [contactPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  estimates                   Estimate[]
  timeEntries                 TimeEntry[]
  contactPersons              ContactPerson[]
  movieBillingHeadAssignments MovieBillingHeadAssignment[]
  assetNames                  AssetName[]
  purchaseOrderAssignments    PurchaseOrderAssignment[]
  billingRecords              BillingRecord[]
  copyDecks                   CopyDeck[]

  @@index([clientId, isActive])
  @@index([contactPersonId])
  @@index([billingSocial])
  @@index([title])
}


model AssetName {
  id        String   @id @default(cuid())
  clientId  String
  movieId   String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movie       Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  estimates   Estimate[]
  timeEntries TimeEntry[]

  @@unique([movieId, name])
  @@index([clientId, isActive])
  @@index([movieId, isActive])
  @@index([name])
}

model Newsletter {
  id             String          @id @default(cuid())
  clientId       String
  projectId      String?
  name           String
  newsletterType NewsletterType?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  estimates   Estimate[]
  timeEntries TimeEntry[]

  @@unique([clientId, name])
  @@index([clientId, isActive])
  @@index([projectId])
  @@index([newsletterType])
  @@index([name])
}

model MovieBillingHead {
  id                     String                     @id @default(cuid())
  clientId               String
  name                   String
  compulsionType         MovieBillingHeadCompulsion @default(FIXED_COMPULSORY)
  domesticCompulsionType MovieBillingHeadCompulsion @default(FIXED_COMPULSORY)
  intlCompulsionType     MovieBillingHeadCompulsion @default(FIXED_COMPULSORY)
  otherCompulsionType    MovieBillingHeadCompulsion @default(FIXED_COMPULSORY)
  domesticActive         Boolean                    @default(true)
  intlActive             Boolean                    @default(true)
  otherActive            Boolean                    @default(false)
  costType               MovieBillingHeadCostType   @default(WHOLE_COST)
  domesticCost           Decimal                    @default(0) @db.Decimal(12, 2)
  intlCost               Decimal                    @default(0) @db.Decimal(12, 2)
  intlCanadaCost         Decimal                    @default(0) @db.Decimal(12, 2)
  otherCost              Decimal                    @default(0) @db.Decimal(12, 2)
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  client           Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movieAssignments MovieBillingHeadAssignment[]

  @@unique([clientId, name])
  @@index([clientId, isActive])
  @@index([name])
}

model MovieBillingHeadAssignment {
  id            String   @id @default(cuid())
  clientId      String
  countryId     String
  movieId       String
  billingHeadId String
  units         Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  country     Country          @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movie       Movie            @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  billingHead MovieBillingHead @relation(fields: [billingHeadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([countryId, movieId, billingHeadId])
  @@index([clientId])
  @@index([movieId])
  @@index([billingHeadId])
  @@index([isActive])
}

model FilmikResourceType {
  id                    String   @id @default(cuid())
  clientId              String
  name                  String
  cost                  Decimal  @default(0) @db.Decimal(12, 2)
  perResourceVendorCost Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client        Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectCounts ProjectFilmikResourceCount[]

  @@unique([clientId, name])
  @@index([clientId, isActive])
  @@index([name])
}

model ProjectFilmikResourceCount {
  id             String   @id @default(cuid())
  projectId      String
  resourceTypeId String
  effectiveMonth DateTime
  count          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resourceType FilmikResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, resourceTypeId, effectiveMonth])
  @@index([projectId])
  @@index([resourceTypeId])
  @@index([effectiveMonth])
}

model AssetType {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  code        String?  @unique
  description String?  @db.Text
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  estimates   Estimate[]
  timeEntries TimeEntry[]

  @@unique([clientId, name])
  @@index([clientId, isActive])
  @@index([name])
}

model LensType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimates   Estimate[]
  timeEntries TimeEntry[]

  @@index([isActive])
  @@index([name])
}

model Language {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimates   Estimate[]
  timeEntries TimeEntry[]

  @@index([isActive])
  @@index([name])
}

model Country {
  id        String   @id @default(cuid())
  name      String
  isoCode   String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimates                   Estimate[]
  timeEntries                 TimeEntry[]
  contactPersons              ContactPerson[]
  movieBillingHeadAssignments MovieBillingHeadAssignment[]
  purchaseOrderAssignmentCountries PurchaseOrderAssignmentCountry[] @relation("CountryPurchaseOrderAssignmentCountries")
  copyDecks                   CopyDeck[]
  copyDeckMasterEntries       CopyDeckMasterEntry[]
  copyDeckMarkets             CopyDeckMarket[]

  @@index([isActive])
  @@index([name])
}

model Project {
  id                      String        @id @default(cuid())
  clientId                String
  contactPersonId         String?
  projectTypeId           String?
  code                    String?       @unique
  name                    String
  description             String?       @db.Text
  billingModel            BillingModel
  status                  ProjectStatus @default(DRAFT)
  fixedContractHours      Decimal?      @db.Decimal(10, 2)
  fixedMonthlyHours       Decimal?      @db.Decimal(10, 2)
  additionalCharges       Decimal       @default(0) @db.Decimal(12, 2)
  partialBillingCost      Decimal       @default(0) @db.Decimal(12, 2)
  projectCost             Decimal       @default(0) @db.Decimal(12, 2)
  projectCostOtherMovieBillingRegion Decimal @default(0) @db.Decimal(12, 2)
  perCountryCharges       Decimal       @default(0) @db.Decimal(12, 2)
  universalSmallCost      Decimal       @default(0) @db.Decimal(12, 2)
  universalMediumCost     Decimal       @default(0) @db.Decimal(12, 2)
  universalLargeCost      Decimal       @default(0) @db.Decimal(12, 2)
  universalExtraLargeCost Decimal       @default(0) @db.Decimal(12, 2)
  developerCount          Int           @default(0)
  perDeveloperCost        Decimal       @default(0) @db.Decimal(12, 2)
  startDate               DateTime?
  endDate                 DateTime?
  billingDate             DateTime?
  billingInvoiceNumber    String?
  isActive                Boolean       @default(true)
  createdById             String?
  updatedById             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  hideCountriesInEntries  Boolean       @default(false)
  hideMoviesInEntries     Boolean       @default(false)
  hideAssetTypesInEntries Boolean       @default(false)
  hideLensTypesInEntries  Boolean       @default(false)
  hideAssetNamesInEntries Boolean       @default(false)
  hideNewslettersInEntries Boolean      @default(false)
  addToBilling            Boolean       @default(false)
  billingCycle           BillingCycle  @default(ONE_TIME)
  warnerProjectType      WarnerProjectType @default(OTHER)
  sonyProjectType        SonyProjectType @default(OTHER)

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  primaryContactPerson ContactPerson? @relation("ProjectPrimaryContactPerson", fields: [contactPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  projectType ProjectType? @relation(fields: [projectTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy   User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy   User?        @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  subProjects    SubProject[]
  assignedUsers  ProjectUserAssignment[]
  estimates      Estimate[]
  timeEntries    TimeEntry[]
  contactPersons ContactPerson[]
  filmikResourceCounts ProjectFilmikResourceCount[]
  monthlyAdditionalHours ProjectMonthlyAdditionalHours[]
  newsletters Newsletter[]
  purchaseOrderAssignments PurchaseOrderAssignment[]
  billingContactAssignments BillingContactAssignment[]
  billingRecords BillingRecord[]
  copyDecks CopyDeck[]

  @@index([clientId, isActive])
  @@index([contactPersonId])
  @@index([projectTypeId])
  @@index([status])
  @@index([billingModel])
  @@index([createdById])
  @@index([updatedById])
}

model BillingRecord {
  id                String   @id @default(cuid())
  clientId          String
  movieId           String?
  projectId         String?
  purchaseOrderId   String?
  billingReportType String?
  billingMonth      Int?
  billingYear       Int?
  billingDate       DateTime
  invoiceNumber     String?
  amount            Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movie         Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([clientId, billingYear, billingMonth])
  @@index([movieId])
  @@index([projectId])
  @@index([purchaseOrderId])
  @@index([billingReportType])
}

model BillingContactAssignment {
  id                String                        @id @default(cuid())
  clientId          String
  contactPersonId   String
  assignmentLevel   BillingContactAssignmentLevel
  projectId         String?
  billingReportType String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactPerson ContactPerson @relation(fields: [contactPersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clientId, assignmentLevel])
  @@index([contactPersonId])
  @@index([projectId])
  @@index([billingReportType])
}

model ProjectMonthlyAdditionalHours {
  id        String   @id @default(cuid())
  projectId String
  month     DateTime
  hours     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, month])
  @@index([projectId])
  @@index([month])
}

model SubProject {
  id                      String   @id @default(cuid())
  projectId               String
  name                    String
  description             String?  @db.Text
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  hideCountriesInEntries  Boolean  @default(false)
  hideMoviesInEntries     Boolean  @default(false)
  hideAssetTypesInEntries Boolean  @default(false)
  hideLensTypesInEntries  Boolean  @default(false)
  hideAssetNamesInEntries Boolean  @default(false)
  hideNewslettersInEntries Boolean @default(false)

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignments SubProjectAssignment[]
  estimates   Estimate[]
  timeEntries TimeEntry[]
  copyDecks   CopyDeck[]

  @@unique([projectId, name])
  @@index([projectId, isActive])
}

model CopyDeck {
  id               String   @id @default(cuid())
  clientId         String
  movieId          String?
  projectId        String?
  subProjectId     String?
  countryId        String?
  marketId         String?
  name             String
  originalFileName String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client       Client      @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
