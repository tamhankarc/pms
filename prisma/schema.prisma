  @@index([movieId])
  @@index([projectId])
  @@index([subProjectId])
  @@index([countryId])
  @@index([marketId])
  @@index([createdById])
}

model CopyDeckRow {
  id             String                    @id @default(cuid())
  copyDeckId     String
  masterEntryId  String?
  masterTextId   String?
  marketId       String?
  rowOrder       Int
  englishText    String                    @db.Text
  translatedText String                    @db.Text
  source         CopyDeckTranslationSource
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  copyDeck    CopyDeck             @relation(fields: [copyDeckId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  masterEntry CopyDeckMasterEntry? @relation(fields: [masterEntryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  masterText  CopyDeckMasterText?  @relation(fields: [masterTextId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  market      CopyDeckMarket?      @relation(fields: [marketId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([copyDeckId, rowOrder])
  @@index([copyDeckId])
  @@index([masterEntryId])
  @@index([masterTextId])
  @@index([marketId])
}

model CopyDeckMasterEntry {
  id             String                    @id @default(cuid())
  countryId      String
  englishHash    String
  englishText    String                    @db.Text
  translatedText String                    @db.Text
  source         CopyDeckTranslationSource
